# npm 은 engines 를 기본 경고만 한다 — 엄격 모드로 승격해 package.json engines 가드를 강제
engine-strict=true

# 운영 서버의 전역 NODE_ENV=production 은 npm omit 기본값을 dev 로 만든다 — 소스 설치 후 서버
# 빌드에 필수인 devDependencies(typescript·@types·tailwind·postcss·prisma CLI)가 빠져
# next build 가 실패한다(CI 러너에는 NODE_ENV 가 없어 초록 → 운영에서만 깨지는 비대칭).
# include 는 omit 보다 우선 — 이 한 줄이 환경과 무관하게 install 을 결정론적으로 만든다.
# 주의(실측): 이 줄이 있으면 명시적 `npm ci --omit=dev` 도 dev 를 설치한다(include 우선) —
# 런타임 전용 슬림 설치가 정말 필요하면 `npm ci --omit=dev --include=` 로 include 를 비운다.
include=dev
